# Phantom / Solana treasury wallet (base58 public key).
# Replace with your real Phantom receive address before going live.
VITE_TREASURY_WALLET=REPLACE_WITH_PHANTOM_ADDRESS

# SOL charged per pixel. Michael must set this to ≈ €1 worth of SOL
# at the current EUR/SOL rate (example: if 1 SOL ≈ €200, use 0.005).
# Default below is a placeholder rate — update before launch.
VITE_SOL_PER_PIXEL=0.005

# Optional: custom Solana RPC (defaults to public mainnet-beta).
# Free public RPCs rate-limit; for production consider a free Helius/QuickNode tier.
# VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
