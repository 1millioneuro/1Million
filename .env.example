# Phantom receive address (public). Not a private key.
# Production builds also read .env.production (same treasury + rate).
VITE_TREASURY_WALLET=GXoU9jG9G4iGrquMLfyMvUuzW6Rvn2t5nGSC1UWg5y57

# SOL per pixel ≈ €1. Recalculate when SOL/EUR moves. (1/87.28 ≈ 0.0115 as of setup)
VITE_SOL_PER_PIXEL=0.0115

# Optional custom RPC (tried first). Do not use api.mainnet-beta.solana.com
# from the browser — it returns 403 Access forbidden (GitHub Pages / CORS).
# Defaults: PublicNode, then LeoRPC (CORS-friendly, no API key).
VITE_SOLANA_RPC=https://solana-rpc.publicnode.com
